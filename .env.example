# Copie ce fichier en .env puis adapte les valeurs. Tout est optionnel :
# sans .env, Jarvis démarre avec les valeurs par défaut indiquées ici.

# ── Persona ────────────────────────────────────────────────────────────────
# Formule d'appel employée par Jarvis (« Monsieur » comme dans Iron Man ; « Madame », un prénom…)
JARVIS_USER_TITLE=Monsieur
# Ville par défaut pour la météo et le briefing
JARVIS_CITY=Paris

# ── Modèle de langage (Ollama) ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=jarvis
# Modèle de base utilisé par ./run_jarvis.sh create quand aucun GGUF fine-tuné n'est présent
JARVIS_BASE_MODEL=gemma4:e4b
# 0 (défaut) : Jarvis converse librement. 1 : il refuse tout ce qui n'est pas une action.
JARVIS_STRICT_ACTIONS_ONLY=0
# 1 (défaut) : confirmation avant d'envoyer un mail ou de supprimer en masse
JARVIS_CONFIRM_ACTIONS=1
# 1 (défaut) : Jarvis cherche lui-même sur le web (DuckDuckGo) et lit les pages pour répondre.
# 0 : rien ne sort du poste ; il ouvre seulement la recherche dans le navigateur.
JARVIS_WEB_SEARCH=1

# ── Voix ───────────────────────────────────────────────────────────────────
# Synthèse : auto (piper, sinon say sur macOS, sinon navigateur) | piper | say | browser | off
JARVIS_TTS_ENGINE=auto
JARVIS_PIPER_VOICE=fr_FR-tom-medium
# Voix macOS pour le moteur say (vide = meilleure voix française installée)
JARVIS_TTS_VOICE=
# Débit de la voix (1.0 = normal)
JARVIS_TTS_RATE=1.0
# Reconnaissance : auto (puce graphique du Mac, sinon processeur, sinon navigateur) | mlx | whisper | browser | off
JARVIS_STT_ENGINE=auto
# Vide = large-v3-turbo sur la puce graphique, small sur le processeur (tiny | base | small | medium | large-v3-turbo)
JARVIS_WHISPER_MODEL=
JARVIS_WAKE_WORD=jarvis
# Noms propres à bien reconnaître à l'oral (lieux, enseignes, prénoms), séparés par des virgules.
# La ville (JARVIS_CITY) et les contacts du carnet d'adresses sont ajoutés automatiquement.
JARVIS_STT_VOCABULARY=

# ── Serveur ────────────────────────────────────────────────────────────────
# Jarvis n'écoute que ce poste par défaut. Pour l'ouvrir au réseau local :
# JARVIS_HOST=0.0.0.0 et JARVIS_ALLOWED_ORIGINS=http://192.168.1.20:8001
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8001
JARVIS_ALLOWED_ORIGINS=
# 1 : autorise les clients distants (Discord) à piloter le poste (applications, volume, veille)
JARVIS_REMOTE_SYSTEM_CONTROL=0
# Tant que Jarvis tourne, le Mac ne s'endort pas (l'écran s'éteint quand même), pour répondre au
# téléphone : secteur (seulement branché, par défaut) | toujours (sur batterie aussi) | 0 (jamais).
# Capot fermé, un MacBook dort dans tous les cas.
JARVIS_KEEP_AWAKE=secteur
# Lancé à la demande par le service macOS, Jarvis s'arrête après ce nombre de minutes sans demande
# (interface fermée partout, aucune alarme en attente). 0 : il reste allumé une fois lancé.
JARVIS_IDLE_MINUTES=20

# ── Bot Telegram (./run_jarvis.sh telegram) ───────────────────────────────
# Lance et arrête Jarvis à distance. Les deux valeurs sont écrites par ./run_jarvis.sh telegram.
# Token donné par @BotFather (secret)
TELEGRAM_BOT_TOKEN=
# Identifiants des comptes autorisés (séparés par des virgules) ; tous les autres sont ignorés
TELEGRAM_ALLOWED_USERS=

# ── Google (Gmail + Calendar) ──────────────────────────────────────────────
# Chemin du JSON « client OAuth » téléchargé depuis Google Cloud Console (obligatoire pour Google)
# GOOGLE_CLIENT_SECRET_FILE=/chemin/vers/Jarvis/API/google-client-secret.json
# Emplacement du token (par défaut : Jarvis/API/.google-token.json)
# GOOGLE_TOKEN_FILE=/chemin/vers/Jarvis/API/.google-token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Europe/Paris
# 1 (défaut) : le token Google est effacé à l'arrêt de l'API. 0 : il est conservé.
GOOGLE_FORGET_TOKEN_ON_EXIT=1

# ── Alarmes locales ────────────────────────────────────────────────────────
# Emplacement des alarmes (par défaut : Jarvis/API/.alarms.json)
# ALARMS_FILE=/chemin/vers/Jarvis/API/.alarms.json
ALARM_NOTIFICATION_ENABLED=1
ALARM_SOUND_ENABLED=1
ALARM_SOUND_REPEAT=1
# Fichier son personnalisé (vide = carillon du système)
ALARM_SOUND_FILE=

# ── Modèle : mémoire de travail ────────────────────────────────────────────
# La même pour tous les appels (conversation et créations) : le modèle n'est jamais rechargé.
# JARVIS_NUM_CTX=12288
# Modèle à part pour les créations (code, pages, logos, documents), par exemple plus gros.
# Il tourne en même temps que la conversation, qui n'attend plus derrière une création.
# Vide = le modèle de la conversation.
# JARVIS_CREATION_MODEL=gemma4:26b

# ── Agents ─────────────────────────────────────────────────────────────────
# Point de départ des trajets (une adresse précise est plus juste que la ville)
# JARVIS_HOME_ADDRESS=1 place de la Mairie, 31770 Colomiers
# Ce que Jarvis retient de vous (« souviens-toi que… »)
# JARVIS_MEMORY_FILE=Jarvis/API/.memory.json
# Phrases que le routeur n'a pas reconnues (« /incompris » pour les voir)
# JARVIS_MISSES_FILE=Jarvis/API/.incompris.jsonl
# Routines (« mode travail ») : listes de phrases exécutées à la suite
# (les routines à heure fixe sont dans routines-horaires.json, à côté)
# JARVIS_ROUTINES_FILE=Jarvis/API/routines.json
# Le modèle trie les mails non lus quand vous demandez vos mails (0 = la liste seule)
# JARVIS_MAIL_TRIAGE=1
# Prévenir avant un rendez-vous : marge en minutes avant le départ, trajet compris (0 = jamais)
# JARVIS_MEETING_REMINDER_MINUTES=10

# ── Créations (agents code et design) ──────────────────────────────────────
# Dossier des scripts, pages, logos et palettes créés par Jarvis
# JARVIS_CREATIONS_DIR=~/Documents/Jarvis
# Longueur maximale d'une création, en jetons (environ 20 par seconde)
# JARVIS_CREATION_MAX_TOKENS=6000
# L'agent code lance chaque script Python dans un bac à sable avant de le livrer (1 = oui)
# JARVIS_CODE_TRIAL_RUN=1
# L'agent design regarde le rendu de sa création et corrige les défauts graves (1 = oui)
# JARVIS_DESIGN_SELF_REVIEW=1
# Navigateur pour l'export PDF (vide = Chrome, Edge, Brave ou Chromium, trouvé seul)
# JARVIS_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── Bot Discord ────────────────────────────────────────────────────────────
DISCORD_TOKEN=
JARVIS_API_URL=http://127.0.0.1:8001/api/chat
