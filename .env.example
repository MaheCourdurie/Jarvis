# Copie ce fichier en .env puis adapte les valeurs. Tout est optionnel :
# sans .env, Jarvis démarre avec les valeurs par défaut indiquées ici.

# ── Persona ────────────────────────────────────────────────────────────────
# Formule d'appel employée par Jarvis (« Monsieur » comme dans Iron Man ; « Madame », un prénom…)
JARVIS_USER_TITLE=Monsieur
# Ville par défaut pour la météo et le briefing
JARVIS_CITY=Paris

# ── Modèle de langage (Ollama) ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=jarvis
# Modèle de base utilisé par ./run_jarvis.sh create quand aucun GGUF fine-tuné n'est présent
JARVIS_BASE_MODEL=gemma4:e4b
# 0 (défaut) : Jarvis converse librement. 1 : il refuse tout ce qui n'est pas une action.
JARVIS_STRICT_ACTIONS_ONLY=0
# 1 (défaut) : confirmation avant d'envoyer un mail ou de supprimer en masse
JARVIS_CONFIRM_ACTIONS=1
# 1 (défaut) : Jarvis cherche lui-même sur le web (DuckDuckGo) et lit les pages pour répondre.
# 0 : rien ne sort du poste ; il ouvre seulement la recherche dans le navigateur.
JARVIS_WEB_SEARCH=1

# ── Voix ───────────────────────────────────────────────────────────────────
# Synthèse : auto (piper, sinon say sur macOS, sinon navigateur) | piper | say | browser | off
JARVIS_TTS_ENGINE=auto
JARVIS_PIPER_VOICE=fr_FR-tom-medium
# Voix macOS pour le moteur say (vide = meilleure voix française installée)
JARVIS_TTS_VOICE=
# Débit de la voix (1.0 = normal)
JARVIS_TTS_RATE=1.0
# Reconnaissance : auto (puce graphique du Mac, sinon processeur, sinon navigateur) | mlx | whisper | browser | off
JARVIS_STT_ENGINE=auto
# Vide = large-v3-turbo sur la puce graphique, small sur le processeur (tiny | base | small | medium | large-v3-turbo)
JARVIS_WHISPER_MODEL=
JARVIS_WAKE_WORD=jarvis
# Noms propres à bien reconnaître à l'oral (lieux, enseignes, prénoms), séparés par des virgules.
# La ville (JARVIS_CITY) et les contacts du carnet d'adresses sont ajoutés automatiquement.
JARVIS_STT_VOCABULARY=

# ── Serveur ────────────────────────────────────────────────────────────────
# Jarvis n'écoute que ce poste par défaut. Pour l'ouvrir au réseau local :
# JARVIS_HOST=0.0.0.0 et JARVIS_ALLOWED_ORIGINS=http://192.168.1.20:8001
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8001
JARVIS_ALLOWED_ORIGINS=
# 1 : autorise les clients distants (Discord) à piloter le poste (applications, volume, veille)
JARVIS_REMOTE_SYSTEM_CONTROL=0

# ── Google (Gmail + Calendar) ──────────────────────────────────────────────
# Chemin du JSON « client OAuth » téléchargé depuis Google Cloud Console (obligatoire pour Google)
# GOOGLE_CLIENT_SECRET_FILE=/chemin/vers/Jarvis/API/google-client-secret.json
# Emplacement du token (par défaut : Jarvis/API/.google-token.json)
# GOOGLE_TOKEN_FILE=/chemin/vers/Jarvis/API/.google-token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Europe/Paris
# 1 (défaut) : le token Google est effacé à l'arrêt de l'API. 0 : il est conservé.
GOOGLE_FORGET_TOKEN_ON_EXIT=1

# ── Alarmes locales ────────────────────────────────────────────────────────
# Emplacement des alarmes (par défaut : Jarvis/API/.alarms.json)
# ALARMS_FILE=/chemin/vers/Jarvis/API/.alarms.json
ALARM_NOTIFICATION_ENABLED=1
ALARM_SOUND_ENABLED=1
ALARM_SOUND_REPEAT=1
# Fichier son personnalisé (vide = carillon du système)
ALARM_SOUND_FILE=

# ── Bot Discord ────────────────────────────────────────────────────────────
DISCORD_TOKEN=
JARVIS_API_URL=http://127.0.0.1:8001/api/chat
